+    static void mirror(String text, int caret, InputConnection ic) {
+        sText = text;
+        sCaret = caret;
+        if (ic instanceof SDLInputConnection) {
+            ((SDLInputConnection) ic).setField(text, caret);
+            ((SDLInputConnection) ic).report();
+        }
+    }
+
+    // Sets mCommittedText too, so the next updateText sends no scancodes for text the app already holds.
+    private void setField(String text, int caret) {
+        Editable content = getEditable();
+        if (!text.contentEquals(content)) {
+            content.replace(0, content.length(), text);
+            removeComposingSpans(content);
+        }
+        Selection.setSelection(content, Math.max(0, Math.min(caret, content.length())));
+        mCommittedText = text;
+    }
+
+    @Override
+    public ExtractedText getExtractedText(ExtractedTextRequest request, int flags) {
+        if (request != null && (flags & GET_EXTRACTED_TEXT_MONITOR) != 0) {
+            mMonitored = true;
+            mExtractToken = request.token;
+        }
+        ExtractedText et = extract();
+        Log.i("SDL", "keyboard box: extract length=" + et.text.length() + " caret=" + et.selectionEnd
+                + " monitor=" + mMonitored);
+        return et;
+    }
+
+    // partialStartOffset -1 is a whole snapshot; the default 0 makes the box insert it at its start,
+    // so a second request shows the text twice.
+    private ExtractedText extract() {
+        Editable content = getEditable();
+        ExtractedText et = new ExtractedText();
+        et.text = content.toString();
+        et.partialStartOffset = -1;
+        et.partialEndOffset = -1;
+        et.selectionStart = Selection.getSelectionStart(content);
+        et.selectionEnd = Selection.getSelectionEnd(content);
+        return et;
+    }
+
+    // An IME learns of our edits only from these calls; the box keeps its own copy otherwise.
+    private void report() {
+        Editable content = getEditable();
+        InputMethodManager imm = (InputMethodManager) SDL.getContext().getSystemService(Context.INPUT_METHOD_SERVICE);
+        imm.updateSelection(mView, Selection.getSelectionStart(content), Selection.getSelectionEnd(content),
+                getComposingSpanStart(content), getComposingSpanEnd(content));
+        if (mMonitored) {
+            imm.updateExtractedText(mView, mExtractToken, extract());
+        }
+    }
